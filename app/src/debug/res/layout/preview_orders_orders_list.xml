<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Thẻ đơn hàng mẫu. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/nova_card"
        android:padding="16dp"
        android:layout_marginBottom="10dp">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="NOVA-1024   ·   Đang giao"/>
        <Space android:layout_width="1dp" android:layout_height="7dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_muted"
            tools:text="Sony WH-1000XM5  ×  1&#10;Tổng thanh toán  5.990.000₫"/>
        <Space android:layout_width="1dp" android:layout_height="9dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_brand"
            android:textStyle="bold"
            tools:text="Xem chi tiết  →"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/nova_card"
        android:padding="16dp"
        android:layout_marginBottom="10dp">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="NOVA-1015   ·   Đã giao"/>
        <Space android:layout_width="1dp" android:layout_height="7dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_muted"
            tools:text="Apple iPhone 16  ×  1&#10;Tổng thanh toán  19.990.000₫"/>
        <Space android:layout_width="1dp" android:layout_height="9dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_brand"
            android:textStyle="bold"
            tools:text="Xem chi tiết  →"/>
    </LinearLayout>
</LinearLayout>
