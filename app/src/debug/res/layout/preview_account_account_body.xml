<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Hồ sơ, thẻ thành viên, trạng thái đơn và nhóm tiện ích mẫu. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <include layout="@layout/component_account_identity" />
    <Space android:layout_width="1dp" android:layout_height="20dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/nova_blue_card"
        android:padding="16dp">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/nova_on_blue_muted"
            android:textStyle="bold"
            tools:text="NOVA / THÀNH VIÊN"/>
        <Space android:layout_width="1dp" android:layout_height="7dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/nova_white"
            android:textStyle="bold"
            tools:text="Thành viên NOVA"/>
        <Space android:layout_width="1dp" android:layout_height="7dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/nova_white"
            tools:text="240 điểm tích lũy"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="Đơn hàng của tôi"/>
        <Space android:layout_width="1dp" android:layout_height="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:textSize="11sp"
                android:textColor="@color/nova_blue"
                android:textStyle="bold"
                tools:text="Chờ xác nhận"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:background="@drawable/nova_secondary_button"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:textSize="11sp"
                android:textColor="@color/nova_muted"
                tools:text="Đang xử lý"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:background="@drawable/nova_card"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:textSize="11sp"
                android:textColor="@color/nova_muted"
                tools:text="Đang giao"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:background="@drawable/nova_card"/>
        </LinearLayout>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="16dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/nova_card">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/node_6_2783_imgmappin"
                android:importantForAccessibility="no"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/nova_ink"
                tools:text="Sổ địa chỉ"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/nova_muted"
                tools:text="›"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/node_6_2783_imgwallet"
                android:importantForAccessibility="no"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/nova_ink"
                tools:text="Lịch sử thanh toán"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/nova_muted"
                tools:text="›"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/node_6_2783_imgticketpercent"
                android:importantForAccessibility="no"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/nova_ink"
                tools:text="Ưu đãi của tôi"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/nova_muted"
                tools:text="›"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/node_6_2783_imgshieldcheck"
                android:importantForAccessibility="no"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/nova_ink"
                tools:text="Đổi mật khẩu"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/nova_muted"
                tools:text="›"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/home_imgheart1"
                android:importantForAccessibility="no"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/nova_ink"
                tools:text="Sản phẩm yêu thích"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/nova_muted"
                tools:text="›"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/node_6_2783_imgpackage"
                android:importantForAccessibility="no"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/nova_ink"
                tools:text="Đổi trả &amp; hoàn tiền"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/nova_muted"
                tools:text="›"/>
        </LinearLayout>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="10dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            style="@style/NovaText"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="11sp"
            android:textColor="@color/nova_blue"
            android:textStyle="bold"
            tools:text="Trung tâm hỗ trợ"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="5dp"
            android:background="@drawable/nova_secondary_button"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:textSize="11sp"
            android:textColor="@color/nova_muted"
            tools:text="Đăng xuất"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginEnd="5dp"
            android:background="@drawable/nova_card"/>
    </LinearLayout>
</LinearLayout>
