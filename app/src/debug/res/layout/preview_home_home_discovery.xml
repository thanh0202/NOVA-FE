<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Khu bán chạy và nổi bật. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="Khám phá thêm"/>
        <Space android:layout_width="1dp" android:layout_height="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:textSize="11sp"
                android:textColor="@color/nova_blue"
                android:textStyle="bold"
                tools:text="Bán chạy"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:background="@drawable/nova_secondary_button"/>
            <TextView
                style="@style/NovaText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:textSize="11sp"
                android:textColor="@color/nova_muted"
                tools:text="Nổi bật"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:background="@drawable/nova_card"/>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="10dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginEnd="5dp">
                <include layout="@layout/item_product_card"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginStart="5dp">
                <include layout="@layout/preview_product_second"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
