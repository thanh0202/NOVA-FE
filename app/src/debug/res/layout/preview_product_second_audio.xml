<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Thẻ AirPods dùng trong lưới âm thanh. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/nova_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <ImageView
        android:id="@+id/card_product_image"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/nova_product_surface"
        android:scaleType="fitCenter"
        android:padding="4dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/home_imgnhsnphm2"/>
    <TextView
        android:id="@+id/card_product_name"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="top"
        tools:text="AirPods Pro 2"/>
    <TextView
        android:id="@+id/card_product_rating"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="6dp"
        android:textSize="10sp"
        android:textColor="@color/nova_muted"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="★ 4,8  ·  96 đánh giá"/>
    <TextView
        android:id="@+id/card_product_price"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/nova_brand"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="4.990.000₫"/>
    <TextView
        android:id="@+id/card_product_old_price"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:visibility="invisible"
        android:textColor="@color/nova_muted"
        android:maxLines="1"
        tools:text="5.990.000₫"
        tools:visibility="visible"/>
    <LinearLayout
        android:id="@+id/card_product_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone"/>
</LinearLayout>
