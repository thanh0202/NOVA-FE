<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Dải ô danh mục con ở danh sách sản phẩm. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/nova_category_card">
        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_category_generic"
            android:importantForAccessibility="no"
            android:layout_gravity="center"/>
        <Space android:layout_width="1dp" android:layout_height="5dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="Tất cả"
            android:gravity="center"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/nova_category_card">
        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/home_imgnhsnphm"
            android:importantForAccessibility="no"
            android:layout_gravity="center"/>
        <Space android:layout_width="1dp" android:layout_height="5dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="Tai nghe"
            android:gravity="center"/>
    </LinearLayout>
</LinearLayout>
