            android:paddingHorizontal="13dp" android:layout_marginEnd="6dp" android:gravity="center"
            android:textSize="12sp" android:background="@drawable/nova_secondary_button" tools:text="Xiaomi"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="12dp" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:padding="10dp" android:layout_marginEnd="6dp" android:background="@drawable/nova_card">
