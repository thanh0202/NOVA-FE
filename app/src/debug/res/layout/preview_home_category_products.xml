        <TextView style="@style/NovaText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:textSize="13sp" android:textStyle="bold" tools:text="Máy tính bảng"/>
        <TextView style="@style/NovaText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:textSize="13sp" android:textStyle="bold" tools:text="Laptop"/>
