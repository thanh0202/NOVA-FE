                android:minLines="2" android:maxLines="2" tools:text="Tất cả"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="6dp" android:layout_marginEnd="6dp"
