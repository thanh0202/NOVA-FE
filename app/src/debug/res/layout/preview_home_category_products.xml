                android:layout_marginTop="10dp" android:textSize="13sp" android:textStyle="bold" android:minLines="2" tools:text="Apple iPhone 16 128GB"/>
            <TextView style="@style/NovaText" android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginTop="6dp" android:textSize="10sp" android:textColor="@color/nova_muted" tools:text="Chưa có đánh giá"/>
            <TextView style="@style/NovaText" android:layout_width="match_parent" android:layout_height="wrap_content"
