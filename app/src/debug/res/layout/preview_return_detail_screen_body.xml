<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Trạng thái và tiến trình đổi trả. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/nova_card"
        android:padding="16dp"
        android:layout_marginBottom="10dp">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="Đơn hàng NOVA-1024"/>
        <Space android:layout_width="1dp" android:layout_height="7dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_muted"
            tools:text="Đang tiếp nhận&#10;Lý do: Sản phẩm có lỗi khi sử dụng."/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/nova_card"
        android:padding="16dp"
        android:layout_marginBottom="10dp">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            tools:text="Tiến trình xử lý"/>
        <Space android:layout_width="1dp" android:layout_height="7dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_muted"
            tools:text="05/11/2026  ·  Đã gửi yêu cầu&#10;NOVA đang kiểm tra thông tin."/>
    </LinearLayout>
    <TextView style="@style/NovaButtonPrimary" tools:text="Làm mới yêu cầu"/>
    <Space android:layout_width="1dp" android:layout_height="10dp"/>
    <TextView style="@style/NovaButtonSecondary" tools:text="Xem đơn hàng"/>
</LinearLayout>
