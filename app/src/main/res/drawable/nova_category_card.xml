<?xml version='1.0' encoding='utf-8'?>

<!-- NOVA: Hiệu ứng phản hồi khi chạm lên một thành phần giao diện. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#161765DF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="#ECF3FF" />
                    <stroke android:width="1.5dp" android:color="#1765DF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <stroke android:width="1dp" android:color="#E7ECF5" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>