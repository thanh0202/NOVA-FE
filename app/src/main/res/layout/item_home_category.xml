<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Ô ảnh và tên danh mục trên Trang chủ. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_tile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp"
    android:background="@drawable/nova_home_category_touch"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/category_icon_frame"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/nova_category_photo"
        android:importantForAccessibility="noHideDescendants">
        <ImageView
            android:id="@+id/category_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_category_generic" />
    </FrameLayout>

    <TextView
        android:id="@+id/category_name"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:importantForAccessibility="no" />
</LinearLayout>
