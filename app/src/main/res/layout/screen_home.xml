<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Nạp banner, danh mục hai hàng, hàng mới về, bán chạy và nổi bật. Hiện Flash Sale khi có chương trình hoạt động từ API tương ứng. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_home_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:background="@color/nova_bg"
    tools:showIn="@layout/preview_screen_home">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/home_imgduhiuthnghiu"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:text="@string/screen_nova"
            android:textColor="@color/nova_ink"
            android:textSize="22sp"/>
        <TextView
            android:id="@+id/home_favorites"
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="62dp"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:text="Yêu thích"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/nova_home_action"
            android:focusable="true"/>
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nova_home_action">
            <ImageView
                android:id="@+id/home_notifications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="9dp"
                android:src="@drawable/home_imgbell"
                android:contentDescription="Thông báo"
                android:focusable="true"/>
            <ImageView
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/home_imgthongbaomi"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaButtonSecondary"
        android:id="@+id/home_search"
        android:text="Bạn đang tìm công nghệ gì?"
        android:gravity="center_vertical"
        android:textColor="@color/nova_muted"
        android:background="@drawable/nova_home_search"
        android:textSize="14sp"
        android:textStyle="normal"
        android:drawableStart="@drawable/home_imgsearch"
        android:drawablePadding="10dp"
        android:minHeight="48dp"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <FrameLayout
        android:id="@+id/home_hero"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:visibility="gone"
        android:layout_marginBottom="4dp"
        android:background="@drawable/nova_banner"
        android:clipToOutline="true"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        tools:visibility="visible">
        <ImageView
            android:id="@+id/home_hero_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            tools:src="@drawable/preview_home_banner"/>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/home_banner_controls"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible">
        <ViewStub
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_home_home_banner_controls"
            tools:visibility="visible"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/home_flash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/nova_section_gap"
        android:layout_marginBottom="10dp"
        android:background="@drawable/nova_blue_card"
        android:padding="16dp"
        android:elevation="1dp"
        android:visibility="gone"
        tools:visibility="visible">
        <ViewStub
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_home_home_flash"
            tools:visibility="visible"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Khám phá danh mục"
                android:textSize="18sp"
                android:textStyle="bold"
                style="@style/NovaText"
                android:layout_weight="1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Tất cả  →"
                android:textSize="12sp"
                android:id="@+id/home_category_all"
                android:textStyle="bold"
                android:textColor="@color/nova_brand"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                style="@style/NovaText"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang tải danh mục…"
            android:textSize="13sp"
            android:id="@+id/home_category_state"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/nova_card"
            android:textColor="@color/nova_muted"
            style="@style/NovaText"
            tools:visibility="gone"/>
        <HorizontalScrollView
            android:id="@+id/home_category_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:background="@drawable/nova_home_category_surface"
            android:clipToOutline="true"
            android:fillViewport="false"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:contentDescription="Danh mục sản phẩm"
            tools:visibility="visible">
            <LinearLayout
                android:id="@+id/home_category_columns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <ViewStub
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="nova_preview"
                    tools:layout="@layout/preview_home_home_category_columns"
                    tools:visibility="visible"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <LinearLayout
        android:id="@+id/home_new_arrivals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ViewStub
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_home_home_new_arrivals"
            tools:visibility="visible"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="16dp"/>
    <!-- Vùng dữ liệu khám phá với hai tab Bán chạy và Nổi bật. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/home_discovery">
        <ViewStub
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_home_home_discovery"
            tools:visibility="visible"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <!-- Khối sản phẩm theo danh mục được đặt sau phần khám phá Bán chạy/Nổi bật. -->
    <LinearLayout
        android:id="@+id/home_category_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <ViewStub
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_home_category_products"
            tools:visibility="visible"/>
    </LinearLayout>
</LinearLayout>
