<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Kiểm tra mật khẩu hiện tại, xác nhận mật khẩu mới rồi gửi cập nhật. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_change_password_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:background="@color/nova_bg"
    tools:showIn="@layout/preview_screen_change_password">
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/nova_muted"
        android:text="@string/module_password_intro"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_ink"
        android:text="@string/module_password_current"
        android:textStyle="bold"
        android:labelFor="@+id/password_current"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <EditText
        style="@style/NovaField"
        android:id="@+id/password_current"
        android:inputType="textPassword"
        android:autofillHints="password"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_ink"
        android:text="@string/module_password_next"
        android:textStyle="bold"
        android:labelFor="@+id/password_next"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <EditText
        style="@style/NovaField"
        android:id="@+id/password_next"
        android:inputType="textPassword"
        android:autofillHints="newPassword"
        android:hint="@string/module_password_next_hint"
        android:maxLength="128"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="@color/nova_muted"
        android:text="@string/password_requirements"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_ink"
        android:text="@string/module_password_repeat"
        android:textStyle="bold"
        android:labelFor="@+id/password_repeat"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <EditText
        style="@style/NovaField"
        android:id="@+id/password_repeat"
        android:inputType="textPassword"
        android:autofillHints="newPassword"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView style="@style/NovaButtonPrimary" android:id="@+id/password_save" android:text="@string/module_password_save"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/screen_body"/>
</LinearLayout>
