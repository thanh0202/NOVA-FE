<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Một dòng sản phẩm gợi ý có ảnh, tên, giá hiện tại và giá cũ. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/search_item_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/nova_product_surface"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        tools:src="@drawable/home_imgnhsnphm" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/search_item_name"
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Sony WH-1000XM5" />

        <TextView
            android:id="@+id/search_item_price"
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="15sp"
            android:textColor="@color/nova_brand"
            android:textStyle="bold"
            tools:text="5.990.000₫" />

        <TextView
            android:id="@+id/search_item_original_price"
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:textColor="@color/nova_muted"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="8.490.000₫" />
    </LinearLayout>

    <TextView
        style="@style/NovaText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:text="›"
        android:textColor="@color/nova_muted"
        android:textSize="21sp"
        android:importantForAccessibility="no" />
</LinearLayout>
