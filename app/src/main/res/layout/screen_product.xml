<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Hiện ảnh, mô tả, giá và biến thể. Bản đầy đủ có thao tác yêu thích, giỏ hàng, mua ngay và đánh giá. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_product_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:background="@color/nova_bg"
    tools:showIn="@layout/preview_screen_product">
    <ImageView
        android:id="@+id/product_image"
        android:layout_width="match_parent"
        android:layout_height="252dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/screen_anh_san_pham"
        tools:src="@drawable/home_imgnhsnphm"/>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:fillViewport="false"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/product_gallery_thumbnails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">
            <ViewStub
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="nova_preview"
                tools:layout="@layout/preview_product_product_gallery_thumbnails"
                tools:visibility="visible"/>
        </LinearLayout>
    </HorizontalScrollView>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="@color/nova_blue"
        android:textStyle="bold"
        android:id="@+id/product_brand"
        tools:text="SONY"/>
    <Space android:layout_width="1dp" android:layout_height="7dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="27sp"
        android:textColor="@color/nova_ink"
        android:textStyle="bold"
        android:id="@+id/product_name"
        tools:text="Sony WH-1000XM5"/>
    <Space android:layout_width="1dp" android:layout_height="10dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
            style="@style/NovaText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_muted"
            android:textStyle="normal"
            android:id="@+id/product_rating"
            android:layout_weight="1"
            tools:text="★ 4,9  ·  128 đánh giá"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_brand"
            android:textStyle="bold"
            android:text="@string/screen_yeu_thich_36"
            android:id="@+id/product_favorite"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_brand"
            android:textStyle="bold"
            android:text="@string/screen_bo_luu"
            android:id="@+id/product_unfavorite"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/nova_blue_price"
        android:padding="16dp"
        android:elevation="1dp">
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textColor="@color/nova_white"
            android:textStyle="bold"
            android:id="@+id/product_price"
            tools:text="5.990.000₫"/>
        <Space android:layout_width="1dp" android:layout_height="6dp"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_on_blue_muted"
            android:textStyle="normal"
            android:id="@+id/product_old_price"
            tools:text="8.490.000₫"
            tools:visibility="visible"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_muted"
        android:textStyle="normal"
        android:text="@string/screen_phien_ban"/>
    <RadioGroup android:id="@+id/product_variants" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ViewStub
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_product_product_variants"
            tools:visibility="visible"/>
    </RadioGroup>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/nova_ink"
        android:textStyle="bold"
        android:text="@string/screen_thong_tin_san_pham"/>
    <Space android:layout_width="1dp" android:layout_height="10dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/nova_muted"
        android:textStyle="normal"
        android:id="@+id/product_description"
        tools:text="Tai nghe không dây chống ồn chủ động, thiết kế nhẹ và thời lượng pin đến 30 giờ."/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/nova_ink"
        android:textStyle="bold"
        android:text="@string/screen_danh_gia_tu_khach_hang"/>
    <Space android:layout_width="1dp" android:layout_height="14dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/product_reviews_summary"
        android:textSize="13sp"
        android:textColor="@color/nova_muted"
        tools:text="★ 4,9  ·  128 lượt đánh giá"/>
    <Space android:layout_width="1dp" android:layout_height="12dp"/>
    <TextView style="@style/NovaButtonSecondary" android:id="@+id/product_reviews_all" android:text="Xem tất cả đánh giá"/>
    <ViewStub
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="nova_preview"
        tools:layout="@layout/preview_product_specifications"
        tools:visibility="visible"/>
</LinearLayout>
