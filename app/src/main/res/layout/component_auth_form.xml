<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Các trường email, mật khẩu và thao tác đăng nhập, đăng ký, quên mật khẩu. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:background="@color/nova_bg">
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_ink"
        android:textStyle="bold"
        android:text="@string/screen_email"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:background="@drawable/nova_field"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/node_6_19_imgmail"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <EditText
            style="@style/NovaText"
            android:id="@+id/auth_email"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/nova_ink"
            android:textColorHint="@color/nova_muted"
            android:singleLine="true"
            android:inputType="textEmailAddress"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:autofillHints="emailAddress"
            android:hint="@string/screen_minhanh_nguyen_gmail_com"
            tools:text="minh.anh@example.com"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="18dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_ink"
        android:textStyle="bold"
        android:text="@string/screen_mat_khau"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:background="@drawable/nova_field"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/node_6_19_imglockkeyhole"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <EditText
            style="@style/NovaText"
            android:id="@+id/auth_password"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/nova_ink"
            android:textColorHint="@color/nova_muted"
            android:singleLine="true"
            android:inputType="textPassword"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:autofillHints="password"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="44dp"
            android:src="@drawable/node_6_19_imgeyeoff"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes"
            android:id="@+id/auth_eye"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="0dp"
            android:paddingEnd="5dp"
            android:contentDescription="@string/screen_hien_an_mat_khau"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
    <TextView
        android:id="@+id/auth_password_rules"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/password_requirements"
        android:textSize="12sp"
        android:textColor="@color/nova_muted"
        android:visibility="gone"/>
    <Space android:layout_width="1dp" android:layout_height="18dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <CheckBox
            android:id="@+id/auth_remember"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/screen_ghi_nho_dang_nhap"
            android:textSize="12sp"
            android:textColor="@color/nova_muted"
            android:checked="true"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/nova_brand"
            android:textStyle="bold"
            android:text="@string/screen_quen_mat_khau"
            android:id="@+id/auth_forgot"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="18dp"/>
    <TextView style="@style/NovaButtonPrimary" android:id="@+id/auth_submit" android:text="@string/screen_dang_nhap"/>
    <Space android:layout_width="1dp" android:layout_height="24dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/nova_border"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/nova_muted"
            android:textStyle="normal"
            android:text="@string/screen_hoac_tiep_tuc_voi"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/nova_border"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_brand"
        android:textStyle="bold"
        android:text="@string/screen_chua_co_tai_khoan_dang_ky_ngay"
        android:id="@+id/auth_switch"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"/>
    <Space android:layout_width="1dp" android:layout_height="12dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/node_6_19_imgshieldcheck"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/nova_muted"
            android:textStyle="normal"
            android:text="@string/screen_thong_tin_cua_ban_luon_duoc_bao_mat"/>
    </LinearLayout>
</LinearLayout>
