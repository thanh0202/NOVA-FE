<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Xác nhận mã cho đăng ký, khôi phục mật khẩu hoặc đổi email. Xử lý gửi lại mã theo luồng. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ns0="http://schemas.android.com/tools"
    android:id="@+id/screen_otp_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" ns0:context=".MainActivity" ns0:showIn="@layout/preview_screen_otp">
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="24dp"
        android:padding="17dp"
        android:background="@drawable/nova_icon_action"
        android:src="@drawable/nova01_otp_mail"
        android:importantForAccessibility="no"/>
    <TextView
        android:id="@+id/otp_step"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BƯỚC 2 / 3"
        android:textSize="12sp"
        android:textColor="@color/nova_brand" ns0:text="BƯỚC 2 / 3"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xác thực OTP"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>
    <TextView
        android:id="@+id/otp_description"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nova_muted"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>
    <TextView
        android:id="@+id/otp_email"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="24dp" ns0:text="minh.anh@example.com"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã xác thực"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="9dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="60dp">
        <LinearLayout
            android:id="@+id/otp_boxes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="noHideDescendants">
            <ViewStub
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="nova_preview" ns0:layout="@layout/preview_otp_otp_boxes" ns0:visibility="visible"/>
        </LinearLayout>
        <EditText
            android:id="@+id/otp_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="number"
            android:maxLength="6"
            android:singleLine="true"
            android:background="@android:color/transparent"
            android:textColor="@android:color/transparent"
            android:cursorVisible="false"
            android:contentDescription="Mã OTP gồm sáu chữ số"/>
    </FrameLayout>
    <TextView
        android:id="@+id/otp_message"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp"
        android:textSize="12sp"
        android:textColor="@color/nova_brand"
        android:gravity="center_vertical" ns0:text="Mã có hiệu lực trong 04:32"/>
    <TextView android:id="@+id/otp_submit" style="@style/NovaButtonPrimary" android:text="Tiếp tục"/>
    <TextView
        android:id="@+id/otp_resend"
        style="@style/NovaButtonSecondary"
        android:text="Gửi lại mã"
        android:layout_marginTop="12dp" ns0:text="Gửi lại mã sau 00:28"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/nova_muted"
        android:textSize="11sp"
        android:layout_marginTop="12dp"
        android:text="Nếu chưa thấy email, kiểm tra thư mục Spam."/>
</LinearLayout>
