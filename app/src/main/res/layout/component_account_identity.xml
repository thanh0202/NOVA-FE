<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Khối ảnh đại diện mặc định, tên, email và nút sửa hồ sơ trên màn Tài khoản. Dùng chung cho giao diện khi chạy và Preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:background="@drawable/nova_card"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/account_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nova_account_avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/account_name"
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Nguyễn Minh Anh" />

        <TextView
            android:id="@+id/account_email"
            style="@style/NovaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nova_muted"
            android:textSize="12sp"
            tools:text="minh.anh@example.com" />

        <TextView
            android:id="@+id/account_edit_profile"
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:text="@string/nova_account_edit_profile"
            android:textColor="@color/nova_brand"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
