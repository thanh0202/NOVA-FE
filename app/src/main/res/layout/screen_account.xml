<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Hiển thị hồ sơ tóm tắt, đăng xuất, lối vào địa chỉ, đơn hàng, thành viên và các tiện ích. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_account_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:background="@color/nova_bg"
    tools:showIn="@layout/preview_screen_account">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
            style="@style/NovaText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/account_title"
            android:textSize="24sp"
            android:textColor="@color/nova_ink"
            android:textStyle="bold"
            android:text="@string/screen_tai_khoan"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/node_6_2783_imgnotifications"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes"
            android:id="@+id/account_notifications"
            android:contentDescription="@string/screen_thong_bao"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="20dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/account_body">
        <ViewStub
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_account_account_body"
            tools:visibility="visible"/>
    </LinearLayout>
</LinearLayout>
