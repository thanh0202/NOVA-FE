<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Kiểm tra độ mạnh và xác nhận mật khẩu mới sau bước OTP. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_reset_password_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    tools:background="@color/nova_bg"
    tools:context=".MainActivity"
    tools:showIn="@layout/preview_screen_reset_password">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/reset_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/nova_recovery_back"
            android:src="@drawable/node_6_279_imgbackarrow"
            android:padding="10dp"
            android:contentDescription="@string/recovery_back"
            android:clickable="true"
            android:focusable="true"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView
            android:id="@+id/reset_help"
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/recovery_help"
            android:textColor="@color/nova_blue"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="28dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="148dp">
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/nova_recovery_symbol">
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/node_6_279_imglockkeyhole"
                android:importantForAccessibility="no"/>
        </FrameLayout>
    </FrameLayout>
    <Space android:layout_width="1dp" android:layout_height="28dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View android:layout_width="28dp" android:layout_height="4dp" android:background="@drawable/nova_primary_button"/>
        <View
            android:layout_width="28dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nova_primary_button"/>
        <View
            android:layout_width="28dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nova_primary_button"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/recovery_step"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/nova_muted"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="28dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recovery_title"
        android:textSize="30sp"
        android:textStyle="bold"/>
    <Space android:layout_width="1dp" android:layout_height="10dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recovery_intro"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/nova_muted"/>
    <Space android:layout_width="1dp" android:layout_height="28dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recovery_new_password"
        android:textSize="12sp"
        android:textStyle="bold"
        android:labelFor="@+id/reset_new_password"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/nova_field"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/node_6_279_imglock"
            android:importantForAccessibility="no"/>
        <EditText
            android:id="@+id/reset_new_password"
            style="@style/NovaText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:padding="0dp"
            android:background="@null"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="14sp"
            android:autofillHints="newPassword"
            android:imeOptions="actionNext"/>
        <ImageView
            android:id="@+id/reset_show_password"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="15dp"
            android:src="@drawable/node_6_279_imgpasswordvisibility"
            android:contentDescription="@string/recovery_show_password"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="18dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recovery_confirm_password"
        android:textSize="12sp"
        android:textStyle="bold"
        android:labelFor="@+id/reset_confirm_password"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/nova_field"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/node_6_279_imglock"
            android:importantForAccessibility="no"/>
        <EditText
            android:id="@+id/reset_confirm_password"
            style="@style/NovaText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:padding="0dp"
            android:background="@null"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="14sp"
            android:autofillHints="newPassword"
            android:imeOptions="actionDone"/>
        <ImageView
            android:id="@+id/reset_show_confirm"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="15dp"
            android:src="@drawable/node_6_279_imgpasswordvisibility"
            android:contentDescription="@string/recovery_show_password"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="18dp"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recovery_password_hint"
        android:textSize="12sp"
        android:textColor="@color/nova_muted"/>
    <Space android:layout_width="1dp" android:layout_height="28dp"/>
    <LinearLayout
        android:id="@+id/reset_submit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/nova_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recovery_update"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/nova_white"/>
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/node_6_279_imgsecurityshield"
            android:importantForAccessibility="no"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="24dp"/>
    <TextView
        android:id="@+id/reset_login"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/recovery_login"
        android:textSize="13sp"
        android:textColor="@color/nova_blue"
        android:clickable="true"
        android:focusable="true"/>
    <Space android:layout_width="1dp" android:layout_height="10dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/node_6_279_imgsecurityshield1"
            android:importantForAccessibility="no"/>
        <TextView
            style="@style/NovaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/recovery_security"
            android:textSize="11sp"
            android:textColor="@color/nova_muted"/>
    </LinearLayout>
</LinearLayout>
