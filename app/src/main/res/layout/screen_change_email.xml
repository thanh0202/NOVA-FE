<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Nhập địa chỉ mới và mật khẩu hiện tại, gửi yêu cầu rồi mở bước xác thực OTP. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_change_email_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:background="@color/nova_bg"
    tools:showIn="@layout/preview_screen_change_email">
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/nova_muted"
        android:text="@string/module_email_intro"/>
    <TextView
        android:id="@+id/email_current"
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="@color/nova_muted"
        tools:text="minh.anh@example.com"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_ink"
        android:text="@string/module_email_new"
        android:textStyle="bold"
        android:labelFor="@+id/email_new"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <EditText
        style="@style/NovaField"
        android:id="@+id/email_new"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        tools:text="minh.anh.nova@example.com"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/nova_ink"
        android:text="@string/module_email_password"
        android:textStyle="bold"
        android:labelFor="@+id/email_password"/>
    <Space android:layout_width="1dp" android:layout_height="8dp"/>
    <EditText
        style="@style/NovaField"
        android:id="@+id/email_password"
        android:inputType="textPassword"
        android:autofillHints="password"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <TextView style="@style/NovaButtonPrimary" android:id="@+id/email_submit" android:text="@string/module_email_submit"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/screen_body"/>
</LinearLayout>
