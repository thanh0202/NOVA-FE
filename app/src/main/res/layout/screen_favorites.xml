<?xml version="1.0" encoding="utf-8"?>

<!-- NOVA: Nạp lưới các sản phẩm khách đã lưu và cho phép mở chi tiết. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen_favorites_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:context=".MainActivity"
    tools:background="@color/nova_bg"
    tools:showIn="@layout/preview_screen_favorites">
    <TextView
        style="@style/NovaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/nova_muted"
        android:text="@string/module_favorites_intro"/>
    <Space android:layout_width="1dp" android:layout_height="@dimen/nova_section_gap"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/screen_body">
        <ViewStub
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="nova_preview"
            tools:layout="@layout/preview_favorites_screen_body"
            tools:visibility="visible"/>
    </LinearLayout>
</LinearLayout>
